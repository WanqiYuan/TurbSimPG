uint3 bucketGridRes;
float3 bucketGridOrigin;
float bucketGridCellSize;

uint GetBucketIndex(uint3 cell)
{
    if (any(cell >= bucketGridRes))
        return 0xFFFFFFFF;
    return cell.x + cell.y * bucketGridRes.x + cell.z * bucketGridRes.x * bucketGridRes.y;
}

